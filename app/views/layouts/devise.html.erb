<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sign In" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="auth-body" style="background-image: url('https://images.unsplash.com/photo-1670121180583-39ab653a071c?fm=jpg&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTB8fHNoaXBwaW5nJTIwcG9ydHxlbnwwfHwwfHx8MA%3D%3D&ixlib=rb-4.1.0&q=60&w=3000'); background-size: cover; background-position: center;">
    <div class="auth-wrapper d-flex align-items-center justify-content-start vh-100">
      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
