<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "App Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Este es el que activa los métodos como :delete en los links -->
    <%= javascript_importmap_tags %>

    <style>
      body {
        background-color: #1e1e1e;
        color: #f8f9fa;
        margin: 0;
      }

      .navbar-custom {
        background-color: #1a1a1a;
        box-shadow: 0 2px 8px rgba(0,0,0,0.5);
        z-index: 9999;
      }

      .sidebar {
        width: 220px;
        height: calc(100vh - 56px);
        background-color: #2c2c2c;
        color: white;
        position: fixed;
        top: 56px;
        left: 0;
        padding: 20px 10px;
        border-radius: 0;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
      }

      .sidebar a {
        color: #ffffff;
        text-decoration: none;
        display: block;
        margin: 12px 0;
        padding: 10px;
        border-radius: 8px;
        transition: background 0.3s ease;
      }

      .sidebar a:hover {
        background-color: #3a3a3a;
      }

      .content-area {
        margin-left: 220px;
        padding: 30px;
        margin-top: 56px;
      }

      .navbar-custom .navbar-brand {
        color: #f8f9fa;
      }

      .btn-white-outline {
        border: 1px solid #ffffff !important;
        color: #ffffff !important;
        background: transparent !important;
      }

      .btn-white-outline:hover {
        background-color: #ffffff !important;
        color: #1a1a1a !important;
      }
    </style>
  </head>

  <body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top px-4">
  <div class="container-fluid">
    <%= link_to "App Dashboard", root_path, class: "navbar-brand fw-bold" %>
    <div class="d-flex ms-auto">
      <% if user_signed_in? %>
        <%= link_to "My Account", edit_user_registration_path, class: "btn btn-white-outline me-2" %>

        <%= button_to "Logout", destroy_user_session_path,
            method: :delete,
            class: "btn btn-white-outline me-2",
            form: { class: "d-inline", data: { turbo: false } } %>
      <% else %>
        <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-white-outline me-2" %>
        <%= link_to "Login", new_user_session_path, class: "btn btn-white-outline" %>
      <% end %>
    </div>
  </div>
</nav>


    <!-- Sidebar -->
    <div class="sidebar">
      <%= link_to "Página Principal", root_path, class: "nav-link" %>
      <%= link_to "Nombre de Ejemplo", "#", class: "nav-link" %>
      <%= link_to "Configuración", "#", class: "nav-link" %>
      <%= link_to "Panel de Administrador", "#", class: "nav-link" %>
    </div>

    <!-- Contenido -->
    <div class="content-area">
      <% if notice %>
        <div class="alert alert-info text-center"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger text-center"><%= alert %></div>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
