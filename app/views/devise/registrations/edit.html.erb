<div class="glass-wrapper d-flex align-items-center justify-content-center vh-100">
  <div class="glass-card p-5 rounded-4 shadow-lg" style="max-width: 600px; width: 100%;">
    <h2 class="text-center mb-4 fw-bold text-white">Mi cuenta</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <div class="mb-3">
        <%= f.label :email, "Correo electrónico", class: "form-label text-white" %>
        <%= f.email_field :email, autofocus: true, class: "form-control bg-transparent text-white border-white" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Nueva contraseña", class: "form-label text-white" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control bg-transparent text-white border-white" %>
        <div class="form-text text-light">Déjalo en blanco si no deseas cambiarla</div>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirmar contraseña", class: "form-label text-white" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control bg-transparent text-white border-white" %>
      </div>

      <div class="mb-4">
        <%= f.label :current_password, "Contraseña actual", class: "form-label text-white" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control bg-transparent text-white border-white" %>
        <div class="form-text text-light">Necesaria para confirmar cambios</div>
      </div>

      <div class="d-grid">
        <%= f.submit "Actualizar", class: "btn btn-outline-light fw-bold" %>
      </div>
    <% end %>

    <hr class="my-4 border-light">

    <h5 class="text-danger fw-semibold">¿Deseas eliminar tu cuenta?</h5>
    <%= button_to "Eliminar cuenta", registration_path(resource_name), method: :delete,
                  data: { confirm: "¿Estás seguro de que deseas eliminar tu cuenta?" },
                  class: "btn btn-outline-danger w-100 mt-2" %>
  </div>
</div>
